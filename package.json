{
  "name": "easy-poker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "多人在线德州扑克（长牌现金桌），Cloudflare Workers 全栈",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "wrangler dev --config wrangler.toml --port 8789 --inspector-port 9229",
    "dev:web": "wrangler dev --config wrangler.web.toml --port 8787 --inspector-port 9230",
    "deploy": "npm run deploy:api && npm run deploy:web",
    "deploy:api": "wrangler deploy --config wrangler.toml",
    "deploy:web": "wrangler deploy --config wrangler.web.toml",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "sounds": "node scripts/generate-sounds.mjs",
    "voices": "node scripts/generate-emote-voices.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^4.34.0"
  }
}
